---
type Status = 'runtime' | 'federated' | 'capability' | 'graph';

interface Props {
	status: Status;
	label?: string;
	class?: string;
}

const { status, label, class: className = '' } = Astro.props;

const config: Record<Status, { text: string; styles: string; dot: string }> = {
	runtime: {
		text: 'Runtime',
		styles: 'border-teal-300/60 bg-teal-300/10 text-teal-100',
		dot: 'bg-teal-300',
	},
	federated: {
		text: 'Federated',
		styles: 'border-cyan-300/60 bg-cyan-300/10 text-cyan-100',
		dot: 'bg-cyan-300',
	},
	capability: {
		text: 'Capability',
		styles: 'border-amber-300/60 bg-amber-300/10 text-amber-100',
		dot: 'bg-amber-300',
	},
	graph: {
		text: 'Graph native',
		styles: 'border-slate-300/60 bg-slate-300/10 text-slate-200',
		dot: 'bg-slate-300',
	},
};

const c = config[status];
const text = label ?? c.text;
---

<span class={`inline-flex items-center gap-2 rounded-full border px-2.5 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.12em] ${c.styles} ${className}`}>
	<span class={`size-1.5 rounded-full ${c.dot}`} aria-hidden="true"></span>
	{text}
</span>
