---
import { BookOpen, GitBranch } from '@lucide/astro';

const path = Astro.url.pathname;
const items = [
	{ href: '/local/', label: 'Local' },
	{ href: '/architecture/', label: 'Architecture' },
	{ href: '/roadmap/', label: 'Roadmap' },
	{ href: '/blog/', label: 'Blog' },
];
---

<header class="relative z-20">
	<div class="container-wide flex min-h-[76px] flex-wrap items-center justify-between gap-4 py-4">
		<a href="/" class="group inline-flex items-center gap-3 text-white no-underline" aria-label="Entangle home">
			<span class="grid size-9 place-items-center rounded-[6px] border border-teal-300/[0.45] bg-teal-300/[0.12] font-mono text-sm font-black text-teal-200">E</span>
			<span class="text-base font-[820] tracking-[0.01em]">Entangle</span>
		</a>
		<nav class="order-3 flex w-full items-center gap-1 overflow-x-auto text-sm font-semibold text-slate-300 md:order-2 md:w-auto md:overflow-visible" aria-label="Primary navigation">
			{items.map((item) => (
				<a
					href={item.href}
					class={`rounded-[6px] px-3 py-2 no-underline transition hover:bg-white/[0.08] hover:text-white ${path.startsWith(item.href) ? 'bg-white/10 text-white' : ''}`}
				>
					{item.label}
				</a>
			))}
		</nav>
		<div class="order-2 flex items-center gap-2 md:order-3">
			<a href="/docs/" class="hidden items-center gap-2 rounded-[6px] border border-white/15 px-3 py-2 text-sm font-bold text-slate-100 no-underline transition hover:border-white/30 hover:bg-white/[0.08] md:inline-flex">
				<BookOpen size={16} strokeWidth={2.2} />
				Docs
			</a>
			<a href="https://github.com/entangle-run/entangle" class="inline-flex items-center gap-2 rounded-[6px] bg-teal-100 px-3 py-2 text-sm font-bold text-slate-950 no-underline transition hover:bg-white" rel="noreferrer">
				<GitBranch size={16} strokeWidth={2.2} />
				GitHub
			</a>
		</div>
	</div>
</header>
