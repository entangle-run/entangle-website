---
const columns = [
	{
		label: 'Products',
		links: [
			{ href: '/products/', label: 'Overview' },
			{ href: '/local/', label: 'Entangle Local' },
			{ href: '/cloud/', label: 'Entangle Cloud' },
			{ href: '/enterprise/', label: 'Entangle Enterprise' },
		],
	},
	{
		label: 'Learn',
		links: [
			{ href: '/architecture/', label: 'Architecture' },
			{ href: '/roadmap/', label: 'Roadmap' },
			{ href: '/docs/', label: 'Docs' },
			{ href: '/blog/', label: 'Blog' },
		],
	},
	{
		label: 'Project',
		links: [
			{ href: 'https://github.com/entangle-run/entangle', label: 'GitHub repository' },
			{ href: '/security/', label: 'Security' },
			{ href: '/rss.xml', label: 'RSS feed' },
		],
	},
];
---

<footer class="border-t border-slate-200 bg-white">
	<div class="container-wide grid gap-10 py-12 md:grid-cols-[1.1fr_2fr]">
		<div>
			<a href="/" class="inline-flex items-center gap-3 text-slate-950 no-underline">
				<span class="grid size-9 place-items-center rounded-[6px] border border-teal-500/35 bg-teal-50 font-mono text-sm font-black text-teal-700">E</span>
				<span class="font-[820]">Entangle</span>
			</a>
			<p class="mt-4 max-w-xs text-sm leading-6 text-slate-600">
				Graph-native runtime for AI organizations. Local-first today; managed Cloud and customer-operated Enterprise on the roadmap.
			</p>
		</div>
		<nav class="grid gap-8 sm:grid-cols-3" aria-label="Footer navigation">
			{columns.map((column) => (
				<div>
					<p class="text-xs font-black uppercase tracking-[0.14em] text-slate-500">{column.label}</p>
					<ul class="mt-4 grid gap-2 list-none p-0">
						{column.links.map((link) => (
							<li>
								<a href={link.href} class="text-sm font-semibold text-slate-700 no-underline hover:text-teal-700">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</nav>
	</div>
	<div class="border-t border-slate-200 py-4">
		<div class="container-wide flex flex-wrap items-center justify-between gap-3 text-xs font-semibold text-slate-500">
			<span>© {new Date().getFullYear()} Entangle. Public website and documentation.</span>
			<span>Local-first · open source · graph-native</span>
		</div>
	</div>
</footer>
