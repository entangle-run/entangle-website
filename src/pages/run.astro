---
import { ArrowRight, BookOpen, GitBranch, Network, Route, Terminal, Users } from '@lucide/astro';
import CommandBlock from '../components/CommandBlock.astro';
import CtaStrip from '../components/CtaStrip.astro';
import EntangleGraph from '../components/EntangleGraph.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusPill from '../components/StatusPill.astro';

const services = [
	{ label: 'Host', value: 'Graph authority, runner registry, assignments, projection, and APIs.' },
	{ label: 'Relay', value: 'strfry Nostr relay for signed coordination events.' },
	{ label: 'Runners', value: 'Generic node executors that join and receive assignments.' },
	{ label: 'User Client', value: 'A participant surface for a running human node.' },
	{ label: 'Studio', value: 'Admin control room for graph, state, runners, and audit.' },
	{ label: 'CLI', value: 'Scriptable surface over the same Host projection.' },
];

const proofSteps = [
	{ Icon: Network, label: 'Start the relay', body: 'The compact developer path uses a reachable local relay, but the runtime still treats it as an external coordination service.' },
	{ Icon: Users, label: 'Run a User Node', body: 'The user-node runtime signs launches, replies, and approvals with stable graph identity instead of acting as the Host.' },
	{ Icon: Terminal, label: 'Run the fake OpenCode proof', body: 'The fake endpoint gives deterministic agent output so the end-to-end path can be checked without paid LLM credentials.' },
	{ Icon: GitBranch, label: 'Inspect artifacts', body: 'Outputs are materialized through git-backed artifact refs rather than large Nostr payloads.' },
];
---

<SiteLayout
	title="Run Entangle: developer proof"
	description="Run the current Entangle developer proof with Host, relay, runners, User Node runtime, Studio, CLI, deterministic agent execution, and git-backed artifacts."
>
	<main>
		<section class="hero-band pb-16 pt-12 text-white md:pb-24 md:pt-16">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
				<div>
					<div class="flex items-center gap-2">
						<StatusPill status="runtime" label="Developer proof" />
					</div>
					<h1 class="mt-5 text-balance text-5xl font-[880] leading-[0.98] md:text-7xl">Run the current runtime path.</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
						Entangle is pre-release, but the core operating path is runnable: Host, relay, runner registration, runtime assignments, user-node interaction, deterministic agent execution, artifact refs, Studio, and CLI.
					</p>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a href="/docs/getting-started/" class="button-primary">
							<BookOpen size={18} stroke-width={2.4} />
							Step-by-step
							<ArrowRight size={16} stroke-width={2.4} />
						</a>
						<a href="https://github.com/entangle-run/entangle" class="button-secondary" rel="noreferrer">
							<GitBranch size={18} stroke-width={2.4} />
							Repository
						</a>
					</div>
				</div>
				<div class="panel p-5">
					<div class="grid gap-3 sm:grid-cols-2">
						{services.map((s) => (
							<div class="rounded-[6px] border border-white/10 bg-white/[0.05] p-4">
								<p class="font-mono text-[11px] font-black uppercase tracking-[0.14em] text-teal-200">{s.label}</p>
								<p class="mt-1.5 text-sm leading-6 text-slate-300">{s.value}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section-pad bg-white">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
				<div>
					<p class="eyebrow text-teal-700">Fast path</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Verify the system without real LLM credentials.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-600">
						The fastest useful proof keeps the deployment compact while preserving federated boundaries. It uses fake OpenCode/model responses by design so CI and local smoke tests are deterministic.
					</p>
					<div class="mt-7 grid gap-3 text-sm font-bold text-slate-700">
						<div class="flex items-start gap-3"><Route size={18} class="mt-0.5 shrink-0 text-teal-700" stroke-width={2.3} />Host API defaults to <code class="font-mono text-slate-900">localhost:7071</code></div>
						<div class="flex items-start gap-3"><Route size={18} class="mt-0.5 shrink-0 text-teal-700" stroke-width={2.3} />Relay defaults to <code class="font-mono text-slate-900">ws://localhost:7777</code></div>
						<div class="flex items-start gap-3"><Route size={18} class="mt-0.5 shrink-0 text-teal-700" stroke-width={2.3} />Studio is optional for the smoke path and available for manual inspection.</div>
					</div>
				</div>
				<div class="grid gap-4">
					<CommandBlock
						caption="install + verify"
						commands={[
							'git clone https://github.com/entangle-run/entangle.git',
							'cd entangle && pnpm install --frozen-lockfile',
							'pnpm verify',
						]}
					/>
					<CommandBlock
						caption="start relay"
						commands={[
							'docker compose -f deploy/federated-dev/compose/docker-compose.federated-dev.yml up -d strfry',
						]}
					/>
					<CommandBlock
						caption="run deterministic proofs"
						commands={[
							'pnpm ops:demo-user-node-runtime:fake-opencode',
							'pnpm ops:smoke-federated-process-runner:fake-opencode',
						]}
					/>
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-700">What this proves</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">A compact deployment, not a local-only architecture.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						Running everything on one workstation is a convenience. The proof still exercises Host APIs, relay-backed events, runner assignment semantics, user-node signing, engine boundaries, and artifact references.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
					{proofSteps.map(({ Icon, label, body }) => (
						<article class="paper-panel p-6">
							<Icon size={22} stroke-width={2.2} class="text-teal-700" />
							<h3 class="mt-4 text-lg font-[820] leading-tight text-slate-950">{label}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
				<div>
					<p class="eyebrow text-teal-200">Manual validation</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">Real providers are the next operator test.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-300">
						The runtime can be connected to real OpenCode/provider credentials, but the public proof path intentionally avoids depending on external LLM APIs. Real coding tasks with real provider calls, commits, and PRs should be validated by an operator with the desired credentials and repository access.
					</p>
					<a href="/status/" class="mt-7 inline-flex items-center gap-2 text-sm font-black text-teal-200 no-underline hover:text-white">See status <ArrowRight size={16} stroke-width={2.4} /></a>
				</div>
				<div class="panel p-4">
					<EntangleGraph />
				</div>
			</div>
		</section>

		<CtaStrip />
	</main>
</SiteLayout>
