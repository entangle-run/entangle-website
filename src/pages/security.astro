---
import { ArrowRight, FileLock, KeyRound, Mail, ShieldCheck } from '@lucide/astro';
import CtaStrip from '../components/CtaStrip.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusPill from '../components/StatusPill.astro';

const localScope = [
	{ Icon: KeyRound, title: 'Identity in Local', body: 'Local uses an optional bootstrap operator-token boundary (ENTANGLE_HOST_OPERATOR_TOKEN) with bearer-token propagation through the shared host client, CLI, and Studio. The default local profile is intentionally tokenless for low-friction development. This is not production identity.' },
	{ Icon: FileLock, title: 'Secret handling in Local', body: 'Model and git credentials are resolved by the host into the effective runtime context. Secrets are mounted as files into runner containers. URLs and runtime files do not contain raw token material.' },
	{ Icon: ShieldCheck, title: 'Audit signal in Local', body: 'host.operator_request.completed events capture protected mutation requests. Runtime trace events surface session, conversation, approval, artifact, and runner-turn activity through the host event surface.' },
];

const notInScopeYet = [
	'Production multi-tenant authorization or RBAC',
	'Workspace-aware identity (lands at Cloud C1)',
	'SSO via OIDC, SAML, or SCIM (lands at Enterprise E1/E2)',
	'Production sandbox isolation beyond Docker (lands at Cloud C2)',
	'SOC 2, ISO 27001, HIPAA, or other compliance certifications',
	'Pen-test attestation or third-party security review',
	'Bug bounty program',
];
---

<SiteLayout
	title="Security — Entangle"
	description="Entangle's security posture today is scoped to the Local product. Production identity, RBAC, sandbox isolation, audit export, and compliance work belong to Cloud and Enterprise on the roadmap."
>
	<main>
		<section class="pb-16 pt-12 text-white md:pb-24 md:pt-16">
			<div class="container-wide max-w-5xl">
				<div class="flex items-center gap-2">
					<StatusPill status="released" label="Local scope · honest baseline" />
				</div>
				<h1 class="mt-5 text-balance text-5xl font-[880] leading-[0.98] md:text-7xl">Security, scoped honestly.</h1>
				<p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
					Today Entangle ships a local operator runtime. Production identity, RBAC, sandbox isolation beyond Docker, audit export, and compliance certifications belong to Cloud and Enterprise on the roadmap, not to the Local product.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href="mailto:security@entangle.run" class="button-primary">
						<Mail size={18} stroke-width={2.4} />
						Report a security issue
					</a>
					<a href="/roadmap/" class="button-secondary">See the roadmap</a>
				</div>
			</div>
		</section>

		<section class="section-pad bg-white">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-700">In scope today</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Local-only posture, intentionally narrow.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						The Local product makes specific identity, secret-handling, and audit-signal commitments. Each is bounded to the local profile and is not a production claim.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-3">
					{localScope.map(({ Icon, title, body }) => (
						<article class="paper-panel p-6">
							<Icon size={22} stroke-width={2.2} class="text-teal-700" />
							<h3 class="mt-4 text-lg font-[820] leading-tight text-slate-950">{title}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
				<div>
					<p class="eyebrow text-teal-700">Not in scope yet</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">What we will not claim until it ships.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-700">
						Cloud and Enterprise will introduce these capabilities through the C-series and E-series release trains, with explicit gates documented on the roadmap.
					</p>
					<a href="/roadmap/" class="mt-7 inline-flex items-center gap-2 text-sm font-black text-teal-700 no-underline hover:text-slate-950">Where each capability lands <ArrowRight size={16} stroke-width={2.4} /></a>
				</div>
				<ul class="grid gap-3">
					{notInScopeYet.map((item) => (
						<li class="flex items-start gap-3 rounded-[8px] border border-slate-200 bg-white p-4 text-sm leading-6 text-slate-700">
							<span class="mt-2 size-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
							<span>{item}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide max-w-3xl">
				<p class="eyebrow text-teal-200">Reporting</p>
				<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">If you find a vulnerability.</h2>
				<p class="mt-5 text-lg leading-8 text-slate-300">
					Email <a href="mailto:security@entangle.run" class="text-teal-200 underline">security@entangle.run</a> with reproduction steps and impact. Please give us reasonable time to investigate before public disclosure. We do not currently run a bug bounty program; we will acknowledge and credit valid reports.
				</p>
			</div>
		</section>

		<CtaStrip
			heading="Read the architecture before relying on the boundary."
			body="The site is honest about what Local does and does not own. The architecture page documents the same boundary in technical detail."
		/>
	</main>
</SiteLayout>
