---
import { getCollection } from 'astro:content';
import {
	ArrowRight,
	CircleCheck,
	Eye,
	GitBranch,
	KeyRound,
	Network,
	Radio,
	Terminal,
	Users,
	Workflow,
} from '@lucide/astro';
import CtaStrip from '../components/CtaStrip.astro';
import EntangleGraph from '../components/EntangleGraph.astro';
import LatestPosts from '../components/LatestPosts.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusPill from '../components/StatusPill.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const thesis = [
	{ Icon: Network, label: 'The graph is the runtime', body: 'Nodes, edges, identities, policies, runner placement, and artifact routes are operational state, not a diagram beside the system.' },
	{ Icon: KeyRound, label: 'Every actor has identity', body: 'Host, runner, agent node, user node, git principal, and operator roles stay separate so authority and audit remain legible.' },
	{ Icon: Radio, label: 'Messages coordinate work', body: 'Nostr carries signed control, observation, and node-to-node events. Large work products move through artifact backends.' },
	{ Icon: GitBranch, label: 'Git carries durable output', body: 'Agents publish source changes, reports, wiki updates, and handoff artifacts as refs with history and restore semantics.' },
];

const status = [
	{ label: 'Implemented', body: 'Host APIs, Studio, CLI, runner registry, assignments, signed user-node task/reply/approval paths, artifact publishing, memory, and deterministic distributed smoke coverage.' },
	{ label: 'Deterministic proof', body: 'The strongest automated path uses fake OpenCode/model endpoints so the runtime can be verified without paid LLM credentials.' },
	{ label: 'Manual validation', body: 'Real OpenCode/provider usage, physical multi-machine deployment, and real PR workflows are available for operator testing but remain the next hardening pass.' },
];

const surfaces = [
	{ Icon: Workflow, label: 'Host', body: 'The control plane for graph state, package admission, runner trust, runtime assignments, projection, audit, and APIs.' },
	{ Icon: Terminal, label: 'Runners', body: 'Generic processes that join, advertise capability, accept assignments, and run agent, user-interface, or service nodes.' },
	{ Icon: Users, label: 'User nodes', body: 'Human participants with their own graph identity, inbox, replies, approvals, and artifact review path.' },
	{ Icon: Eye, label: 'Studio and CLI', body: 'Operator surfaces over the same Host projection, with Studio visual and CLI scriptable.' },
];
---

<SiteLayout>
	<main>
		<section class="hero-band relative overflow-hidden pb-16 pt-10 text-white md:pb-24 md:pt-16">
			<div class="container-wide">
				<div class="grid items-center gap-12 lg:grid-cols-[0.92fr_1.08fr]">
					<div>
						<div class="flex flex-wrap items-center gap-2">
							<StatusPill status="federated" label="Pre-release federated runtime" />
						</div>
						<h1 class="mt-6 max-w-4xl text-balance text-5xl font-[880] leading-[0.98] text-white md:text-7xl">
							Run coding agents as a governed graph.
						</h1>
						<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
							Entangle is a self-hosted runtime for observable coding-agent organizations. Agents and human users are graph nodes with identities; runners can live on different machines; messages are signed; work moves through git-backed references.
						</p>
						<div class="mt-8 flex flex-col gap-3 sm:flex-row">
							<a href="/run/" class="button-primary">
								<Terminal size={18} stroke-width={2.4} />
								Run the proof
								<ArrowRight size={16} stroke-width={2.4} />
							</a>
							<a href="/status/" class="button-secondary">
								<CircleCheck size={18} stroke-width={2.4} />
								Current status
							</a>
						</div>
					</div>
					<div class="relative flex min-h-[320px] items-center justify-center lg:min-h-[440px]">
						<EntangleGraph class="max-w-[660px]" />
					</div>
				</div>
				<div class="mt-10 grid gap-3 md:grid-cols-3">
					{status.map((item) => (
						<article class="rounded-[8px] border border-white/10 bg-white/[0.045] p-5">
							<p class="font-mono text-[11px] font-black uppercase tracking-[0.14em] text-teal-200">{item.label}</p>
							<p class="mt-3 text-sm leading-6 text-slate-300">{item.body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-700">Product thesis</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">
							A distributed AI engineering organization, not a chatbot wrapper.
						</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						Entangle keeps topology, identity, policy, execution, artifacts, memory, and observation as explicit runtime boundaries. It is designed so a compact workstation deployment and a multi-machine deployment use the same product model.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
					{thesis.map(({ Icon, label, body }) => (
						<article class="paper-panel p-6">
							<Icon size={22} stroke-width={2.2} class="text-teal-700" />
							<h3 class="mt-4 text-lg font-[820] leading-tight text-slate-950">{label}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<StatusPill status="runtime" label="Runtime surfaces" />
						<h2 class="mt-4 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">The important parts are already visible.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-300">
						The repository now has a working deterministic proof of the federated model. The remaining work is hardening, real-provider validation, and production packaging, not a change in product identity.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
					{surfaces.map(({ Icon, label, body }) => (
						<article class="rounded-[8px] border border-white/10 bg-white/[0.04] p-6">
							<Icon size={22} stroke-width={2.2} class="text-teal-300" />
							<h3 class="mt-4 text-lg font-[820] text-white">{label}</h3>
							<p class="mt-2 text-sm leading-6 text-slate-300">{body}</p>
						</article>
					))}
				</div>
				<div class="mt-10 flex flex-wrap items-center gap-4">
					<a href="/runtime/" class="button-primary">
						See the runtime
						<ArrowRight size={16} stroke-width={2.4} />
					</a>
					<a href="/architecture/" class="inline-flex items-center gap-2 text-sm font-bold text-slate-300 no-underline hover:text-white">Read the architecture <ArrowRight size={16} stroke-width={2.4} /></a>
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#eef6f4]">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
				<div>
					<p class="eyebrow text-teal-800">Current proof</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Run it locally without making the architecture local-only.</h2>
				</div>
				<div>
					<p class="text-lg leading-8 text-slate-700">
						The compact developer profile can run Host, relay, runners, user-client runtime, git backend, Studio, and CLI on one machine. That is a deployment convenience: the runtime path still communicates through explicit APIs, signed events, and artifact references.
					</p>
					<a href="/run/" class="mt-7 inline-flex items-center gap-2 rounded-[6px] border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-900 no-underline hover:border-slate-400">
						Run the developer proof
						<ArrowRight size={16} stroke-width={2.4} />
					</a>
				</div>
			</div>
		</section>

		{posts.length > 0 && <LatestPosts posts={posts} />}

		<CtaStrip />
	</main>
</SiteLayout>
