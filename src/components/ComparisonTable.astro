---
import StatusPill from './StatusPill.astro';

const products = [
	{ key: 'local', name: 'Entangle Local', status: 'released' as const },
	{ key: 'cloud', name: 'Entangle Cloud', status: 'coming-soon' as const },
	{ key: 'enterprise', name: 'Entangle Enterprise', status: 'planned' as const },
];

const rows: { label: string; values: [string, string, string] }[] = [
	{ label: 'Where it runs', values: ['Your machine', 'Managed by Entangle', 'Customer cloud / VPC'] },
	{ label: 'Available', values: ['Today (L1)', 'After Local GA', 'After Cloud production core'] },
	{ label: 'Persistence', values: ['Local files (.entangle/host)', 'Postgres', 'Customer-managed Postgres'] },
	{ label: 'Identity', values: ['Operator token', 'Workspaces, OIDC-ready', 'SSO, SCIM, SAML'] },
	{ label: 'Authorization', values: ['Single operator', 'Workspace RBAC', 'Enterprise RBAC / ABAC'] },
	{ label: 'Sandbox', values: ['Local Docker runtime', 'Production sandbox + scheduler', 'Production sandbox in customer cluster'] },
	{ label: 'Artifact backend', values: ['Local Gitea (git)', 'Object-storage artifact service', 'Customer-managed object storage'] },
	{ label: 'Transport', values: ['Local strfry (NIP-59)', 'Internal event bus + RPC', 'Internal event bus + RPC'] },
	{ label: 'Audit', values: ['Local event log', 'Structured audit log', 'Audit export, SIEM-ready'] },
	{ label: 'Audience', values: ['Builders, demos, CI', 'Teams and companies', 'Regulated organizations'] },
];
---

<div class="rounded-[10px] border border-slate-200 bg-white shadow-[0_18px_60px_rgba(15,23,42,0.08)]">
	<div class="overflow-x-auto">
		<table class="w-full min-w-[720px] text-left text-sm">
			<thead class="border-b border-slate-200 bg-slate-50/60">
				<tr>
					<th scope="col" class="w-44 px-5 py-4 text-xs font-black uppercase tracking-[0.12em] text-slate-500"></th>
					{products.map((p) => (
						<th scope="col" class="px-5 py-4 align-bottom">
							<div class="flex flex-col gap-2">
								<span class="text-base font-[820] text-slate-950">{p.name}</span>
								<StatusPill status={p.status} class="self-start !text-slate-700 !bg-slate-50 !border-slate-200" />
							</div>
						</th>
					))}
				</tr>
			</thead>
			<tbody>
				{rows.map((row, i) => (
					<tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/40'}>
						<th scope="row" class="px-5 py-3.5 text-xs font-black uppercase tracking-[0.12em] text-slate-500">{row.label}</th>
						{row.values.map((v) => (
							<td class="px-5 py-3.5 align-top text-slate-700">{v}</td>
						))}
					</tr>
				))}
			</tbody>
		</table>
	</div>
	<p class="border-t border-slate-200 px-5 py-3 text-xs leading-5 text-slate-500">
		Cloud and Enterprise capabilities describe planned scope. Build sequence and dates depend on Local GA, then on Cloud reaching a production-stable core.
	</p>
</div>
