---
import { BookOpen, GitBranch } from '@lucide/astro';

const path = Astro.url.pathname;
const items = [
	{ href: '/architecture/', label: 'Architecture', match: ['/architecture/'] },
	{ href: '/run/', label: 'Run it', match: ['/run/'] },
	{ href: '/status/', label: 'Status', match: ['/status/'] },
	{ href: '/blog/', label: 'Notes', match: ['/blog/'] },
];

function isActive(matches: string[]) {
	return matches.some((m) => path === m || path.startsWith(m));
}
---

<header class="relative z-20 bg-[#080a12]">
	<div class="container-wide flex min-h-[76px] flex-wrap items-center justify-between gap-4 py-4">
		<a href="/" class="group inline-flex items-center gap-3 text-white no-underline" aria-label="Entangle home">
			<span class="grid size-9 place-items-center rounded-[6px] border border-teal-300/[0.45] bg-teal-300/[0.12] text-teal-200">
				<svg viewBox="0 0 40 40" class="size-6" aria-hidden="true">
					<g fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
						<path d="M25.5 10C15.8 10 9.5 14.1 9.5 20S15.8 30 25.5 30" />
						<path d="M9.5 20H22.5" />
					</g>
					<circle cx="25.5" cy="10" r="4" fill="currentColor" />
					<circle cx="28" cy="20" r="4" fill="none" stroke="currentColor" stroke-width="2.7" />
					<circle cx="25.5" cy="30" r="4" fill="currentColor" />
				</svg>
			</span>
			<span class="text-base font-[820] tracking-[0.01em]">Entangle</span>
		</a>
		<nav class="order-3 flex w-full items-center gap-1 overflow-x-auto text-sm font-semibold text-slate-300 md:order-2 md:w-auto md:overflow-visible" aria-label="Primary navigation">
			{items.map((item) => (
				<a
					href={item.href}
					aria-current={isActive(item.match) ? 'page' : undefined}
					class={`rounded-[6px] px-3 py-2 no-underline transition hover:bg-white/[0.08] hover:text-white ${isActive(item.match) ? 'bg-white/10 text-white' : ''}`}
				>
					{item.label}
				</a>
			))}
		</nav>
		<div class="order-2 flex items-center gap-2 md:order-3">
			<a href="/docs/" class="inline-flex items-center gap-2 rounded-[6px] border border-white/15 px-3 py-2 text-sm font-bold text-slate-100 no-underline transition hover:border-white/30 hover:bg-white/[0.08]">
				<BookOpen size={16} stroke-width={2.2} />
				<span class="hidden sm:inline">Docs</span>
			</a>
			<a href="https://github.com/entangle-run/entangle" class="inline-flex items-center gap-2 rounded-[6px] bg-teal-100 px-3 py-2 text-sm font-bold text-slate-950 no-underline transition hover:bg-white" rel="noreferrer">
				<GitBranch size={16} stroke-width={2.2} />
				<span class="hidden sm:inline">GitHub</span>
			</a>
		</div>
	</div>
</header>
