---
import EntangleGraph from './EntangleGraph.astro';
---

<div class="panel overflow-hidden" aria-label="Entangle runtime visual">
	<div class="flex items-center justify-between border-b border-white/[0.12] bg-white/[0.05] px-4 py-3">
		<div class="flex items-center gap-2" aria-hidden="true">
			<span class="size-2.5 rounded-full bg-[#f97362]"></span>
			<span class="size-2.5 rounded-full bg-[#f59e0b]"></span>
			<span class="size-2.5 rounded-full bg-[#2dd4bf]"></span>
		</div>
		<span class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400">runtime / local profile</span>
	</div>
	<div class="grid gap-0 lg:grid-cols-[1.05fr_0.95fr]">
		<div class="relative border-b border-white/[0.10] p-5 lg:border-b-0 lg:border-r">
			<EntangleGraph />
		</div>
		<div class="bg-slate-950/[0.7] p-5">
			<div class="grid gap-3">
				<div class="rounded-[6px] border border-white/10 bg-white/[0.04] p-4">
					<p class="font-mono text-[11px] font-black uppercase tracking-[0.14em] text-teal-200">Topology is runtime state</p>
					<p class="mt-1.5 text-xs leading-5 text-slate-400">Nodes, edges, sessions, approvals, turns, and artifacts are all inspectable through the host control plane.</p>
				</div>
				<div class="rounded-[6px] border border-white/10 bg-white/[0.04] p-4">
					<p class="font-mono text-[11px] font-black uppercase tracking-[0.14em] text-cyan-200">Signed coordination lane</p>
					<p class="mt-1.5 text-xs leading-5 text-slate-400">Messages flow over a local Nostr relay using NIP-59 gift wrapping and a dedicated Entangle rumor kind.</p>
				</div>
				<div class="rounded-[6px] border border-white/10 bg-white/[0.04] p-4">
					<p class="font-mono text-[11px] font-black uppercase tracking-[0.14em] text-amber-200">Artifacts carry work</p>
					<p class="mt-1.5 text-xs leading-5 text-slate-400">Git-backed materialization through local Gitea, with publish, retrieve, and cache for downstream nodes.</p>
				</div>
				<div class="rounded-[6px] border border-white/10 bg-white/[0.04] p-4">
					<p class="font-mono text-[11px] font-black uppercase tracking-[0.14em] text-lime-200">One runner per active node</p>
					<p class="mt-1.5 text-xs leading-5 text-slate-400">Lifecycle, recovery policy, and effective runtime context are owned by the host and observed per node.</p>
				</div>
			</div>
		</div>
	</div>
</div>
