---
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, GitBranch, GitPullRequest, Network, ShieldCheck, Terminal, Workflow } from '@lucide/astro';
import FeatureCard from '../components/FeatureCard.astro';
import LatestPosts from '../components/LatestPosts.astro';
import RuntimeVisual from '../components/RuntimeVisual.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);
---

<SiteLayout>
	<main>
		<section class="relative overflow-hidden pb-14 pt-10 text-white md:pb-24 md:pt-16">
			<div class="container-wide grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr]">
				<div>
					<p class="eyebrow text-teal-200">Entangle Local is first</p>
					<h1 class="mt-5 max-w-4xl text-balance text-5xl font-[880] leading-[0.98] text-white md:text-7xl">
						Graph-native runtime for AI organizations.
					</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
						Build, run, inspect, and govern multi-agent operating topologies on your machine. Entangle turns users, agents, runners, approvals, messages, and artifacts into first-class runtime state.
					</p>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a href="https://github.com/entangle-run/entangle" class="button-primary">
							<GitBranch size={18} strokeWidth={2.4} />
							View GitHub
						</a>
						<a href="/docs/" class="button-secondary">
							<BookOpen size={18} strokeWidth={2.4} />
							Read Docs
						</a>
					</div>
					<div class="mt-10 grid gap-3 sm:grid-cols-3">
						<div class="border-l border-teal-300/40 pl-4">
							<p class="text-2xl font-[850] text-white">Local</p>
							<p class="mt-1 text-sm leading-6 text-slate-400">first product line</p>
						</div>
						<div class="border-l border-lime-300/40 pl-4">
							<p class="text-2xl font-[850] text-white">Graph</p>
							<p class="mt-1 text-sm leading-6 text-slate-400">explicit topology</p>
						</div>
						<div class="border-l border-amber-300/40 pl-4">
							<p class="text-2xl font-[850] text-white">Artifact</p>
							<p class="mt-1 text-sm leading-6 text-slate-400">git-backed handoff</p>
						</div>
					</div>
				</div>
				<RuntimeVisual />
			</div>
		</section>

		<section class="border-y border-slate-200 bg-white py-5">
			<div class="container-wide grid gap-3 text-sm font-bold text-slate-600 md:grid-cols-4">
				<div class="flex items-center gap-2">
					<Network size={17} class="text-teal-700" strokeWidth={2.3} />
					Graph-native control plane
				</div>
				<div class="flex items-center gap-2">
					<Terminal size={17} class="text-slate-700" strokeWidth={2.3} />
					CLI and Studio surfaces
				</div>
				<div class="flex items-center gap-2">
					<GitPullRequest size={17} class="text-amber-600" strokeWidth={2.3} />
					Git-backed artifacts
				</div>
				<div class="flex items-center gap-2">
					<ShieldCheck size={17} class="text-orange-500" strokeWidth={2.3} />
					Designed for audit loops
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide">
				<div class="max-w-3xl">
					<p class="eyebrow text-teal-700">Why it exists</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.08] text-slate-950 md:text-5xl">
						AI work should be operated as a system, not buried inside one chat window.
					</h2>
					<p class="mt-5 text-lg leading-8 text-slate-600">
						Entangle starts with the local runtime because the core model has to be inspectable before it is scaled. The product line is built around explicit topology, controlled execution, and artifact handoff.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
					<FeatureCard
						kicker="Topology"
						title="Users and agents are nodes"
						description="The operating graph is visible, versionable, and inspectable instead of implied by a hidden prompt chain."
					/>
					<FeatureCard
						kicker="Execution"
						title="One runner per active node"
						description="Runtime ownership stays explicit so node lifecycle, logs, and repair paths can be reasoned about."
					/>
					<FeatureCard
						kicker="Handoff"
						title="Artifacts carry work"
						description="Messages coordinate. Work products move through artifact materialization and git-backed handoff."
					/>
					<FeatureCard
						kicker="Governance"
						title="Review paths are part of the model"
						description="The roadmap treats approvals, audit, and operational recovery as core runtime concerns."
					/>
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
				<div>
					<p class="eyebrow text-lime-200">First product</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.08] md:text-5xl">Entangle Local becomes the first complete product.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-300">
						The release path intentionally finishes the local product before cloud or enterprise work begins. Each release adds utility without pretending the product is already a managed production platform.
					</p>
					<a href="/local/" class="mt-8 inline-flex items-center gap-2 text-sm font-black text-teal-200 no-underline hover:text-white">
						Explore Entangle Local
						<ArrowRight size={16} strokeWidth={2.4} />
					</a>
				</div>
				<div class="grid gap-3">
					{[
						['R1', 'Local Operator Baseline', 'Run and inspect the local control plane, runner, relay, Studio, CLI, and git-backed artifact flow.'],
						['R1.1', 'Local Operator Preview', 'Improve usability around graph inspection, package admission, diagnostics, and operator workflows.'],
						['R1.2', 'Local Workbench', 'Add richer graph editing, templates, task sessions, artifact navigation, and recovery flows.'],
						['GA', 'Entangle Local', 'Complete the local product with installer path, docs, reliability gates, and release discipline.'],
					].map(([step, title, description]) => (
						<div class="grid gap-4 rounded-[8px] border border-white/10 bg-white/[0.06] p-5 sm:grid-cols-[84px_1fr]">
							<div class="font-mono text-sm font-black text-lime-200">{step}</div>
							<div>
								<h3 class="text-xl font-[820] leading-tight">{title}</h3>
								<p class="mt-2 text-sm leading-6 text-slate-400">{description}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#eef6f4]">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.95fr_1.05fr]">
				<div>
					<p class="eyebrow text-teal-800">Product line</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.08] text-slate-950 md:text-5xl">
						One model, three finished products.
					</h2>
					<p class="mt-5 text-lg leading-8 text-slate-700">
						The roadmap does not treat Local as throwaway scaffolding. Local, Cloud, and Enterprise are separate final products built in sequence from the same graph-native operating model.
					</p>
				</div>
				<div class="grid gap-4">
					<div class="paper-panel p-6">
						<div class="flex items-center gap-3">
							<Workflow class="text-teal-700" size={22} strokeWidth={2.3} />
							<h3 class="text-2xl font-[850] text-slate-950">Entangle Local</h3>
						</div>
						<p class="mt-3 text-sm leading-6 text-slate-600">A complete local runtime and operator workbench for serious builders.</p>
					</div>
					<div class="paper-panel p-6">
						<div class="flex items-center gap-3">
							<Network class="text-slate-700" size={22} strokeWidth={2.3} />
							<h3 class="text-2xl font-[850] text-slate-950">Entangle Cloud</h3>
						</div>
						<p class="mt-3 text-sm leading-6 text-slate-600">A managed product for persistent workspaces, identity, authorization, audit, integrations, and hosted reliability.</p>
					</div>
					<div class="paper-panel p-6">
						<div class="flex items-center gap-3">
							<ShieldCheck class="text-amber-700" size={22} strokeWidth={2.3} />
							<h3 class="text-2xl font-[850] text-slate-950">Entangle Enterprise</h3>
						</div>
						<p class="mt-3 text-sm leading-6 text-slate-600">A customer-operated distribution for controlled environments once the cloud production core is mature.</p>
					</div>
				</div>
			</div>
		</section>

		{posts.length > 0 && <LatestPosts posts={posts} />}
	</main>
</SiteLayout>
