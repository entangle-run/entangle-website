---
import { ArrowRight, Cloud as CloudIcon, Eye, FileCode, GitBranch, Mail, Network, ShieldCheck, Workflow } from '@lucide/astro';
import CtaStrip from '../components/CtaStrip.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusPill from '../components/StatusPill.astro';

const plannedScope = [
	{ Icon: Workflow, title: 'Workspaces and tenancy', body: 'Production identity model with users, workspaces, environments, and memberships behind the same control-plane facade Local uses today.' },
	{ Icon: ShieldCheck, title: 'Authorization and audit', body: 'OIDC-ready auth, production authorization checks on mutating endpoints, structured audit log, request ids, and idempotency keys for retryable mutations.' },
	{ Icon: FileCode, title: 'Production sandbox', body: 'A scoped runtime context, secrets, and a sandbox profile for executing graph nodes safely under managed conditions — replacing local Docker isolation.' },
	{ Icon: GitBranch, title: 'Artifact service', body: 'Object-storage-backed artifact service with metadata, lineage, permissions, previews, and publication records — beyond the local Gitea-backed model.' },
	{ Icon: Eye, title: 'Approval and inbox UX', body: 'Workspace approval inbox, session timelines, trace surfaces, and failure evidence backed by the same approval lifecycle the runner already understands.' },
	{ Icon: Network, title: 'Integrations', body: 'Slack, GitHub / GitLab / Gitea, search v1, notifications v1, and a cost dashboard. Connector framework expands after private beta.' },
];

const milestones = [
	{ tag: 'C0', name: 'Cloud Start Gate', body: 'Confirm Local GA exit criteria are met and managed-production work may begin.' },
	{ tag: 'C1', name: 'Cloud Foundation', body: 'PostgreSQL, identity, tenancy, auth, audit, OpenAPI discipline.' },
	{ tag: 'C2', name: 'Governed Execution MVP', body: 'Production session launch, sandbox, model gateway, artifact service, approvals, lineage.' },
	{ tag: 'C3', name: 'Cloud Private Beta', body: 'Onboarding templates, search, notifications, integrations, cost dashboard, runbooks.' },
	{ tag: 'C4', name: 'Cloud Production GA', body: 'Billing, entitlements, SLO dashboards, alerting, backup/restore, security review.' },
	{ tag: 'C5', name: 'Cloud Scale', body: 'Advanced governance, marketplace, analytics, cost optimization, replay/regression workflows.' },
];

const honestNonClaims = [
	'No production tenancy, identity, or RBAC ships until C1.',
	'No managed sandbox or artifact service ships until C2.',
	'No billing, SLAs, or compliance certifications are claimed today.',
	'No customer logos, design partners, or beta cohort exist yet.',
];
---

<SiteLayout
	title="Entangle Cloud — Managed graph-native runtime (coming soon)"
	description="Entangle Cloud is the planned managed product: workspaces, identity, sandboxed execution, an artifact service, audit, and integrations. Begins after Entangle Local GA."
>
	<main>
		<section class="pb-16 pt-12 text-white md:pb-24 md:pt-16">
			<div class="container-wide max-w-5xl">
				<div class="flex flex-wrap items-center gap-2">
					<StatusPill status="coming-soon" />
					<span class="font-mono text-xs font-semibold text-slate-400">Begins after Entangle Local GA</span>
				</div>
				<h1 class="mt-5 text-balance text-5xl font-[880] leading-[0.98] md:text-7xl">
					<CloudIcon class="-mt-4 mr-3 inline-block text-cyan-300" size={64} stroke-width={2} />
					Entangle Cloud
				</h1>
				<p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
					The managed multi-tenant graph runtime. Production persistence, identity, sandboxed execution, artifact service, approvals, audit, and integrations — operated by Entangle so teams don't have to.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href="mailto:hello@entangle.run?subject=Entangle%20Cloud%20interest" class="button-primary">
						<Mail size={18} stroke-width={2.4} />
						Get notified at launch
					</a>
					<a href="/local/" class="button-secondary">
						<Workflow size={18} stroke-width={2.4} />
						Use Entangle Local today
					</a>
				</div>
			</div>
		</section>

		<section class="section-pad bg-white">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-cyan-700">Planned scope</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">What Entangle Cloud will become.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						Cloud inherits the Local control-plane facade and the same graph model. The work is in production persistence, identity, sandboxed execution, an artifact service, and the operational surface around real workspaces.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{plannedScope.map(({ Icon, title, body }) => (
						<article class="paper-panel p-6">
							<Icon size={22} stroke-width={2.2} class="text-cyan-700" />
							<h3 class="mt-4 text-lg font-[820] leading-tight text-slate-950">{title}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-cyan-700">C-series train</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Six milestones from start gate to scale.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						Cloud development sequences strictly after Entangle Local closes its L4 GA gate. Dates are intentionally not promised in public copy.
					</p>
				</div>
				<div class="mt-10 grid gap-3">
					{milestones.map((m) => (
						<article class="grid gap-5 rounded-[8px] border border-slate-200 bg-white p-5 sm:grid-cols-[88px_1fr]">
							<div class="font-mono text-sm font-black text-cyan-700">{m.tag}</div>
							<div>
								<h3 class="text-lg font-[820] leading-tight text-slate-950">{m.name}</h3>
								<p class="mt-2 text-sm leading-6 text-slate-600">{m.body}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
				<div>
					<p class="eyebrow text-cyan-200">Honesty</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">What Cloud is not — yet.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-300">
						We won't sell Cloud capabilities that don't exist. Until those milestones land, the only honest action is to keep Local excellent and to publish the path.
					</p>
					<a href="/roadmap/" class="mt-7 inline-flex items-center gap-2 text-sm font-black text-cyan-200 no-underline hover:text-white">See the full roadmap <ArrowRight size={16} stroke-width={2.4} /></a>
				</div>
				<ul class="grid gap-3">
					{honestNonClaims.map((item) => (
						<li class="flex items-start gap-3 rounded-[8px] border border-white/10 bg-white/[0.04] p-4 text-sm leading-6 text-slate-200">
							<span class="mt-2 size-1.5 shrink-0 rounded-full bg-cyan-300" aria-hidden="true"></span>
							<span>{item}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<CtaStrip
			heading="Today: run Entangle Local. Soon: run Entangle Cloud."
			body="Local proves the architecture. Cloud will scale the same model into a managed multi-tenant product after Local GA."
		/>
	</main>
</SiteLayout>
