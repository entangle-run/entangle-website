---
const columns = [
	{
		label: 'Product',
		links: [
			{ href: '/local/', label: 'Entangle Local' },
			{ href: '/architecture/', label: 'Architecture' },
			{ href: '/roadmap/', label: 'Roadmap' },
		],
	},
	{
		label: 'Resources',
		links: [
			{ href: '/docs/', label: 'Docs' },
			{ href: '/blog/', label: 'Blog' },
			{ href: 'https://github.com/entangle-run/entangle', label: 'GitHub' },
		],
	},
];
---

<footer class="border-t border-slate-200 bg-white">
	<div class="container-wide grid gap-10 py-12 md:grid-cols-[1.2fr_1fr]">
		<div>
			<a href="/" class="inline-flex items-center gap-3 text-slate-950 no-underline">
				<span class="grid size-9 place-items-center rounded-[6px] border border-teal-500/35 bg-teal-50 font-mono text-sm font-black text-teal-700">E</span>
				<span class="font-[820]">Entangle</span>
			</a>
			<p class="mt-4 max-w-md text-sm leading-6 text-slate-600">
				Graph-native runtime for AI organizations. Local first, explicit by design, built toward managed cloud and enterprise operation.
			</p>
		</div>
		<nav class="grid gap-8 sm:grid-cols-2" aria-label="Footer navigation">
			{columns.map((column) => (
				<div>
					<h2 class="text-xs font-black uppercase tracking-[0.14em] text-slate-500">{column.label}</h2>
					<div class="mt-4 grid gap-2">
						{column.links.map((link) => (
							<a href={link.href} class="text-sm font-semibold text-slate-700 no-underline hover:text-teal-700">
								{link.label}
							</a>
						))}
					</div>
				</div>
			))}
		</nav>
	</div>
	<div class="border-t border-slate-200 py-4">
		<div class="container-wide flex flex-wrap items-center justify-between gap-3 text-xs font-semibold text-slate-500">
			<span>© {new Date().getFullYear()} Entangle</span>
			<span>Public website and documentation.</span>
		</div>
	</div>
</footer>
