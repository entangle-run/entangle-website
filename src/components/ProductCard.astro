---
import StatusPill from './StatusPill.astro';
import { ArrowRight } from '@lucide/astro';

interface Props {
	name: string;
	tagline: string;
	href: string;
	cta: string;
	status: 'released' | 'in-progress' | 'coming-soon' | 'planned';
	accent: 'teal' | 'cyan' | 'amber' | 'slate';
	icon?: any;
	bullets: string[];
}

const { name, tagline, href, cta, status, accent, icon: Icon, bullets } = Astro.props;

const accentMap = {
	teal: 'border-teal-300/30 hover:border-teal-300/60',
	cyan: 'border-cyan-300/30 hover:border-cyan-300/60',
	amber: 'border-amber-300/30 hover:border-amber-300/60',
	slate: 'border-slate-300/20 hover:border-slate-300/40',
} as const;

const accentText = {
	teal: 'text-teal-200',
	cyan: 'text-cyan-200',
	amber: 'text-amber-200',
	slate: 'text-slate-200',
} as const;
---

<a href={href} class={`group flex h-full flex-col gap-5 rounded-[10px] border bg-white/[0.03] p-6 no-underline transition hover:bg-white/[0.06] ${accentMap[accent]}`}>
	<div class="flex items-start justify-between gap-3">
		<div class="flex items-center gap-3">
			{Icon && <Icon size={22} stroke-width={2.2} class={accentText[accent]} />}
			<h3 class="text-2xl font-[850] text-white">{name}</h3>
		</div>
		<StatusPill status={status} />
	</div>
	<p class="text-sm leading-6 text-slate-300">{tagline}</p>
	<ul class="grid gap-2 text-sm text-slate-400">
		{bullets.map((b) => (
			<li class="flex items-start gap-2">
				<span class={`mt-2 size-1 shrink-0 rounded-full ${accent === 'teal' ? 'bg-teal-300' : accent === 'cyan' ? 'bg-cyan-300' : accent === 'amber' ? 'bg-amber-300' : 'bg-slate-400'}`} aria-hidden="true"></span>
				<span>{b}</span>
			</li>
		))}
	</ul>
	<span class={`mt-auto inline-flex items-center gap-2 text-sm font-black ${accentText[accent]} group-hover:translate-x-0.5 transition`}>
		{cta}
		<ArrowRight size={16} stroke-width={2.4} />
	</span>
</a>
