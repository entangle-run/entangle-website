---
import { Building2, Cloud, Workflow } from '@lucide/astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import CtaStrip from '../components/CtaStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusPill from '../components/StatusPill.astro';
---

<SiteLayout
	title="Products — Entangle Local, Cloud, and Enterprise"
	description="The Entangle product family: Local available now, Cloud coming after Local GA, Enterprise after the Cloud production core stabilizes. Compare scope, audience, and where each product runs."
>
	<main>
		<section class="pb-16 pt-12 text-white md:pb-24 md:pt-16">
			<div class="container-wide max-w-5xl">
				<div class="flex items-center gap-2">
					<StatusPill status="released" label="Product family" />
				</div>
				<h1 class="mt-5 text-balance text-5xl font-[880] leading-[0.98] md:text-7xl">One graph-native runtime, three finished products.</h1>
				<p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
					Entangle is a single conceptual model — graph topology, host control plane, per-node runners, signed coordination, artifact handoff — packaged in three products with different operational scope.
				</p>
			</div>
		</section>

		<section class="section-pad bg-white">
			<div class="container-wide">
				<div class="grid gap-4 lg:grid-cols-3">
					<ProductCard
						name="Entangle Local"
						tagline="A local operator runtime for builders. Runs the full control plane on your machine with the same boundary the future Cloud and Enterprise products inherit."
						href="/local/"
						cta="Explore Local"
						status="released"
						accent="teal"
						icon={Workflow}
						bullets={[
							'L1 baseline released and verified',
							'Host + per-node runners + Studio + CLI',
							'NIP-59 transport over local strfry',
							'Git-backed artifacts via local Gitea',
							'Two provider adapters (Anthropic, OpenAI-compatible)',
						]}
					/>
					<ProductCard
						name="Entangle Cloud"
						tagline="Managed multi-tenant graph runtime for teams. Production identity, sandboxed execution, an artifact service, audit, and integrations — operated by Entangle."
						href="/cloud/"
						cta="Cloud preview"
						status="coming-soon"
						accent="cyan"
						icon={Cloud}
						bullets={[
							'Begins after Entangle Local GA',
							'Postgres-backed control plane',
							'Workspaces, OIDC, RBAC, audit log',
							'Production sandbox + scheduler',
							'Object-storage artifact service',
						]}
					/>
					<ProductCard
						name="Entangle Enterprise"
						tagline="Customer-operated distribution of the production core for controlled environments. Helm, external dependencies, enterprise identity, audit export, backup, and upgrade."
						href="/enterprise/"
						cta="Enterprise scope"
						status="planned"
						accent="amber"
						icon={Building2}
						bullets={[
							'Begins after Cloud production core stabilizes',
							'Helm chart with external Postgres / object storage / secrets',
							'SSO (OIDC, SAML), SCIM, RBAC/ABAC',
							'Audit export, SIEM integration, support bundle',
							'Air-gapped tier on the long-horizon roadmap',
						]}
					/>
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-700">Compare</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Where they run, what they own, who they're for.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						Same graph model across all three. Different operational scope, different audience, different boundary. The matrix below tracks what is live in Local today versus what is planned for Cloud and Enterprise.
					</p>
				</div>
				<div class="mt-10">
					<ComparisonTable />
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
				<div>
					<p class="eyebrow text-teal-200">Sequencing rule</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">Local first, Cloud second, Enterprise third — strictly.</h2>
				</div>
				<div class="grid gap-4 md:grid-cols-3">
					<div class="rounded-[8px] border border-white/10 bg-white/[0.04] p-5">
						<p class="font-mono text-xs font-black uppercase tracking-[0.14em] text-teal-200">1. Local</p>
						<p class="mt-3 text-sm leading-6 text-slate-300">Finish Local through L4 GA before any production-only infrastructure is built.</p>
					</div>
					<div class="rounded-[8px] border border-white/10 bg-white/[0.04] p-5">
						<p class="font-mono text-xs font-black uppercase tracking-[0.14em] text-cyan-200">2. Cloud</p>
						<p class="mt-3 text-sm leading-6 text-slate-300">Cloud begins at C0 only after Local exits L4. Local stays useful even after Cloud and Enterprise exist.</p>
					</div>
					<div class="rounded-[8px] border border-white/10 bg-white/[0.04] p-5">
						<p class="font-mono text-xs font-black uppercase tracking-[0.14em] text-amber-200">3. Enterprise</p>
						<p class="mt-3 text-sm leading-6 text-slate-300">Enterprise begins only when the Cloud production core is stable enough to package for customer-operated environments.</p>
					</div>
				</div>
			</div>
		</section>

		<CtaStrip
			heading="Start with the Local product. Inherit the same boundary later."
			body="Local is real, runnable, and complete on its own. Cloud and Enterprise will reuse the same graph model and the same host-facing contracts."
		/>
	</main>
</SiteLayout>
