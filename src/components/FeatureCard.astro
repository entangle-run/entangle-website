---
interface Props {
	kicker: string;
	title: string;
	description: string;
}

const { kicker, title, description } = Astro.props;
---

<article class="paper-panel p-6">
	<p class="eyebrow text-teal-700">{kicker}</p>
	<h3 class="mt-4 text-xl font-[820] leading-tight text-slate-950">{title}</h3>
	<p class="mt-3 text-sm leading-6 text-slate-600">{description}</p>
</article>
