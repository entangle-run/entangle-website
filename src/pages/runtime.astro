---
import { Boxes, Eye, GitBranch, Network, Radio, ShieldCheck, Terminal, Users, Workflow } from '@lucide/astro';
import CtaStrip from '../components/CtaStrip.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusPill from '../components/StatusPill.astro';

const surfaces = [
	{ Icon: Workflow, title: 'Host', body: 'The control plane for desired graph state, Host Authority, runner trust, runtime assignments, projection, audit, and public APIs.' },
	{ Icon: Boxes, title: 'Runners', body: 'Generic executors that start without graph context, join with identity, advertise capability, accept assignments, and run nodes.' },
	{ Icon: Users, title: 'User nodes', body: 'Human participants with stable graph identity, inbox/outbox, signed tasks, replies, approvals, and artifact review.' },
	{ Icon: Radio, title: 'Nostr fabric', body: 'Relay-backed signed control, observe, and node-to-node events. Events coordinate; they do not carry full repos or large artifacts.' },
	{ Icon: GitBranch, title: 'Artifact layer', body: 'Git-backed references for source changes, reports, wiki updates, and handoffs, with commit history as lineage.' },
	{ Icon: Eye, title: 'Projection', body: 'Host-owned read models consumed by Studio and CLI, built from desired state and runtime observations.' },
];

const boundaries = [
	{ title: 'Entangle owns organization state', body: 'Graph topology, node identity, runner placement, edge policy, sessions, approvals, memory, artifacts, and observation stay inside Entangle.' },
	{ title: 'Engine adapters own model execution', body: 'OpenCode and other engines are execution brains behind adapters. The runtime should survive engine replacement.' },
	{ title: 'Deployment does not define product identity', body: 'Multiple services can run on one workstation for development, but the same route should work when Host, runners, relay, and git live apart.' },
	{ title: 'Verification is staged', body: 'Deterministic fake-provider smoke tests prove the runtime path. Real-provider and physical multi-machine validation are explicit hardening work.' },
];

const shapes = [
	{ Icon: Terminal, title: 'Developer workstation', body: 'Host, relay, local git service, runners, Studio, CLI, and user-client runtime can run together for fast testing.' },
	{ Icon: Network, title: 'Federated deployment', body: 'Host on one machine, runners and user nodes on others, reachable relay and git backend, and no shared filesystem dependency.' },
	{ Icon: ShieldCheck, title: 'Production posture', body: 'The same model with hardened identity, recovery, audit retention, policy, secrets, and operator lifecycle.' },
];
---

<SiteLayout
	title="The runtime: Entangle"
	description="Entangle runtime model: Host, runners, User Nodes, Nostr event fabric, git-backed artifacts, projection, Studio, and CLI."
>
	<main>
		<section class="hero-band pb-16 pt-12 text-white md:pb-24 md:pt-16">
			<div class="container-wide max-w-5xl">
				<div class="flex items-center gap-2">
					<StatusPill status="runtime" label="Runtime model" />
				</div>
				<h1 class="mt-5 text-balance text-5xl font-[880] leading-[0.98] md:text-7xl">A graph-native runtime for coding-agent organizations.</h1>
				<p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
					Entangle separates authority, execution, identity, coordination, artifacts, user participation, and observation so agents and humans can collaborate as governed nodes.
				</p>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-700">Six surfaces</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">The runtime stays legible because each role is explicit.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						You can inspect who exists, where they run, how they are allowed to communicate, what they produced, and which signed event moved the work forward.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{surfaces.map(({ Icon, title, body }) => (
						<article class="paper-panel p-6">
							<Icon size={22} stroke-width={2.2} class="text-teal-700" />
							<h3 class="mt-4 text-lg font-[820] leading-tight text-slate-950">{title}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-200">Boundaries</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">Built around boundaries that make federation possible.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-300">
						Entangle should not become an LLM engine. It should make strong coding engines usable as governed graph actors with memory, policy, artifacts, and signed collaboration.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2">
					{boundaries.map((d) => (
						<article class="rounded-[8px] border border-white/10 bg-white/[0.04] p-6">
							<p class="font-mono text-[11px] font-black uppercase tracking-[0.14em] text-teal-200">{d.title}</p>
							<p class="mt-3 text-sm leading-6 text-slate-300">{d.body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#eef6f4]">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-800">Deployment shapes</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Same architecture, different placement.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-700">
						The current developer proof is compact, but the target remains federated. If a runtime path only works because Host and runner share a filesystem, it is not the target path.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-3">
					{shapes.map(({ Icon, title, body }) => (
						<article class="paper-panel bg-white p-6">
							<Icon size={22} stroke-width={2.2} class="text-teal-700" />
							<h3 class="mt-4 text-lg font-[820] leading-tight text-slate-950">{title}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/run/" class="button-dark">Run the proof</a>
					<a href="/status/" class="button-dark">Current status</a>
				</div>
			</div>
		</section>

		<CtaStrip />
	</main>
</SiteLayout>
