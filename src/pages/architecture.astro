---
import {
	ArrowRight,
	BookOpen,
	Boxes,
	Eye,
	GitBranch,
	GitMerge,
	KeyRound,
	Network,
	Radio,
	ShieldCheck,
	Users,
	Workflow,
} from '@lucide/astro';
import CtaStrip from '../components/CtaStrip.astro';
import EntangleGraph from '../components/EntangleGraph.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusPill from '../components/StatusPill.astro';

const ownership = [
	{ Icon: KeyRound, label: 'The Host governs the graph', body: 'The Host keeps the desired topology, runner trust, assignments, policy, projection, and audit state under one authority boundary.' },
	{ Icon: Workflow, label: 'Runners execute nodes', body: 'Runners can live on different machines, join generically, receive assignments, start the correct runtime, and report signed observations back to the Host.' },
	{ Icon: Users, label: 'Users participate as nodes', body: 'Human participants sign their own tasks, replies, approvals, and reviews through a User Node identity instead of acting as anonymous chat users.' },
	{ Icon: GitBranch, label: 'Artifacts preserve work', body: 'Messages coordinate the work; git-backed artifacts preserve it. Nodes hand off references instead of moving large payloads through the message bus.' },
];

const concepts = [
	{ Icon: Boxes, title: 'Packages become live nodes', body: 'Reusable agent packages are bound into a graph with identities, routes, policies, memory, and runtime settings.' },
	{ Icon: Network, title: 'Edges define authority', body: 'The graph decides who may delegate, review, escalate, approve, or hand off. Execution follows the route, not a hidden prompt.' },
	{ Icon: Radio, title: 'Nostr carries coordination', body: 'Control commands, runner observations, and node-to-node work messages travel as signed events through relays, even when nodes are on separate networks.' },
	{ Icon: Eye, title: 'Projection makes work visible', body: 'The Host builds a live read model from signed observations so Studio can show state without owning or inventing it.' },
	{ Icon: ShieldCheck, title: 'Approvals are first-class', body: 'Approval requests and responses are explicit runtime events, linked to users, sessions, artifacts, source changes, and policy.' },
	{ Icon: GitMerge, title: 'Engines stay replaceable', body: 'OpenCode and other execution engines sit behind adapters. Entangle owns graph, identity, policy, artifacts, memory, and control.' },
];

const layers = [
	{ name: 'Control surfaces', body: 'Studio gives operators the live control room. CLI gives teams a headless and scriptable surface. User Client gives human nodes their participant interface.' },
	{ name: 'Host control plane', body: 'The Host owns graph state, runner trust, assignments, policy, projection, audit, package admission, and public APIs.' },
	{ name: 'Runners', body: 'Runners advertise capability, accept assignments, run agent, human-interface, or service nodes, and sign runtime observations.' },
	{ name: 'Nostr event fabric', body: 'The relay carries signed control, observation, and node-to-node messages without requiring runners to expose public IP addresses.' },
	{ name: 'Git artifact layer', body: 'A git backend holds work products, source changes, wiki publications, and handoff artifacts with real lineage.' },
];
---

<SiteLayout
	title="Architecture: Entangle"
	description="Entangle architecture for observable coding-agent organizations: Host, distributed runners, User Nodes, Nostr coordination, git-backed artifacts, Studio, and CLI."
>
	<main>
		<section class="hero-band pb-16 pt-12 text-white md:pb-24 md:pt-16">
			<div class="container-wide grid items-center gap-10 lg:grid-cols-[0.92fr_1.08fr]">
				<div>
					<div class="flex items-center gap-2">
						<StatusPill status="federated" label="Federated architecture" />
					</div>
					<h1 class="mt-5 text-balance text-5xl font-[880] leading-[0.98] md:text-7xl">A graph that federates the organization.</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
						Entangle separates the pieces a coding-agent organization needs: authority, execution, identity, coordination, artifacts, memory, and observability. Agents and users can live across machines while Studio keeps the whole graph governable.
					</p>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a href="/docs/architecture/" class="button-primary">
							<BookOpen size={18} stroke-width={2.4} />
							Architecture docs
							<ArrowRight size={16} stroke-width={2.4} />
						</a>
						<a href="/docs/concepts/" class="button-secondary">Concepts overview</a>
					</div>
				</div>
				<div class="panel p-4">
					<EntangleGraph />
				</div>
			</div>
		</section>

		<section class="section-pad bg-white">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-700">Ownership</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Clear ownership at every boundary.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						Federation works because Entangle does not collapse everyone into one orchestrator. The Host governs, runners execute wherever they are placed, users approve as themselves, and agents produce work under their own runtime identities.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2">
					{ownership.map(({ Icon, label, body }) => (
						<article class="paper-panel p-6">
							<Icon size={24} stroke-width={2.2} class="text-teal-700" />
							<h3 class="mt-5 text-xl font-[820] leading-tight text-slate-950">{label}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-700">Concepts</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">The primitives behind the runtime.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
					Entangle keeps topology, policy, messages, artifacts, memory, approvals, and engines on explicit boundaries. That makes the system inspectable, governable, portable, and ready for distributed deployment.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{concepts.map(({ Icon, title, body }) => (
						<article class="paper-panel p-6">
							<Icon size={22} stroke-width={2.2} class="text-teal-700" />
							<h3 class="mt-4 text-lg font-[820] leading-tight text-slate-950">{title}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
				<div>
					<p class="eyebrow text-teal-200">Layers</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">Five layers, one runtime model for federation.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-300">
						Swap an engine, move a runner, change a relay, or point artifacts at a different git service. The graph, authority model, and operating surface remain coherent.
					</p>
				</div>
				<ol class="grid gap-3">
					{layers.map((l, i) => (
						<li class="grid gap-4 rounded-[8px] border border-white/10 bg-white/[0.04] p-5 sm:grid-cols-[64px_1fr] sm:items-center">
							<div class="font-mono text-2xl font-black text-teal-200">{String(i + 1).padStart(2, '0')}</div>
							<div>
								<h3 class="text-lg font-[820] text-white">{l.name}</h3>
								<p class="mt-1.5 text-sm leading-6 text-slate-300">{l.body}</p>
							</div>
						</li>
					))}
				</ol>
			</div>
		</section>

		<CtaStrip />
	</main>
</SiteLayout>
