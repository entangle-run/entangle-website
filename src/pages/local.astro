---
import {
	ArrowRight,
	BookOpen,
	Boxes,
	BadgeCheck,
	CircleDot,
	Eye,
	GitBranch,
	GitMerge,
	Network,
	Radio,
	RefreshCcw,
	Route,
	ShieldCheck,
	Terminal,
	Workflow,
} from '@lucide/astro';
import CommandBlock from '../components/CommandBlock.astro';
import CtaStrip from '../components/CtaStrip.astro';
import EntangleGraph from '../components/EntangleGraph.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusPill from '../components/StatusPill.astro';

const services = [
	{ label: 'Host', value: 'entangle-host control plane and inspection APIs' },
	{ label: 'Runner', value: 'entangle-runner per active node, lifecycle owned' },
	{ label: 'Studio', value: 'Visual operator surface served as static Nginx image' },
	{ label: 'CLI', value: 'entangle-cli over the same host boundary as Studio' },
	{ label: 'Relay', value: 'Local strfry with mounted relay config' },
	{ label: 'Artifacts', value: 'Local Gitea with HTTPS-token or SSH transport' },
];

const l1Capabilities = [
	{ Icon: Workflow, label: 'Host control plane', body: 'Resource-oriented routes for nodes, edges, graph revisions, runtimes, sessions, turns, approvals, artifacts, recovery, package sources, principals, status, and events. REST + WebSocket on the same boundary.' },
	{ Icon: Terminal, label: 'Runner runtime', body: 'Per-node entangle-runner with effective runtime context, peer-route summaries, controlled autonomous handoff validated against autonomy policy and edge routes, runner-owned active-conversation reconciliation.' },
	{ Icon: Radio, label: 'Nostr coordination', body: 'NIP-59 gift-wrapped Entangle rumors over local strfry, with relay-readiness preconnect, signed identity, and a verified live-relay smoke producing persisted session/conversation/turn state.' },
	{ Icon: GitBranch, label: 'Git artifact pipeline', body: 'Local materialization, deterministic remote publication, locator-specific retrieval cache, host-provisioned Gitea repository targets, SSH-key and HTTPS-token transport without leaking secrets to URLs.' },
	{ Icon: GitMerge, label: 'Two provider adapters', body: 'Internal agent-engine boundary with first-party Anthropic and OpenAI-compatible adapters, normalized stop and usage metadata, bounded tool-call loops, and explicit auth-mode contracts.' },
	{ Icon: Eye, label: 'Built-in tools', body: 'Bounded inspect_memory_ref and inspect_session_state for runtime introspection, with diagnostic message capture and runtime-trace surfacing in Studio and CLI.' },
	{ Icon: Boxes, label: 'Memory registers', body: 'Deterministic post-turn task pages plus model-guided synthesis into focused registers (working-context, stable-facts, open-questions, decisions, next-actions, resolutions) with lifecycle discipline.' },
	{ Icon: ShieldCheck, label: 'Approval lifecycle', body: 'A2A approval.request and approval.response metadata contracts, runner-materialized gates, orphan-response guards, approval-aware session synthesis, and host-derived consistency findings.' },
	{ Icon: RefreshCcw, label: 'Recovery and restart', body: 'Persisted reconciliation snapshots, derived finding codes, recovery policies (manual, restart_on_failure), monotonic restart generations, and host-emitted runtime.recovery events.' },
	{ Icon: Network, label: 'Studio + CLI parity', body: 'Studio renders host topology, runtimes, sessions, turns, approvals, artifacts, traces, recovery, and graph revisions. CLI exposes the same surface with --summary output and --dry-run for mutations.' },
	{ Icon: CircleDot, label: 'Local profile', body: 'Hardened Docker Compose for Studio, host, strfry, Gitea, and runner image. Pinned pnpm install, static Nginx Studio runtime, explicit .dockerignore, deploy payload assertions.' },
	{ Icon: BadgeCheck, label: 'Verified smoke', body: 'pnpm ops:check-local:strict for preflight; pnpm ops:smoke-local:disposable:runtime drives a real two-node publish/retrieve roundtrip through the local relay and Gitea.' },
];

const releaseTrain = [
	{ tag: 'L1', name: 'Local Operator Baseline', status: 'released' as const, body: 'Host, runner, relay, Gitea, two provider adapters, approval lifecycle, recovery policy, Studio + CLI parity, preflight, smoke. Architecture-proof release.' },
	{ tag: 'L1.5', name: 'Local Operator Preview', status: 'in-progress' as const, body: 'Demo agent package, demo graph, near one-command demo, troubleshooting guide, clearer Studio empty/error states, smoke as recommended proof path.' },
	{ tag: 'L2', name: 'Local Workbench', status: 'planned' as const, body: 'Package authoring tools, graph templates, graph diff and import/export, Studio session launch, artifact preview, memory workbench.' },
	{ tag: 'L3', name: 'Local Reliability', status: 'planned' as const, body: 'entangle doctor, repair, backup and restore, versioned local state, upgrade notes, diagnostics bundle.' },
	{ tag: 'L4', name: 'Entangle Local GA', status: 'planned' as const, body: 'Polished installer, regression smoke suite, model-provider setup guidance, complete Local non-goals doc, finished local product.' },
];

const notIncluded = [
	'PostgreSQL production persistence',
	'Workspace-aware production identity',
	'Tenant isolation, RBAC, or ABAC',
	'Object-storage artifact service',
	'Production sandbox or scheduler infrastructure',
	'Search, analytics, notifications, billing, compliance',
	'Enterprise self-host packaging or Helm',
];
---

<SiteLayout
	title="Entangle Local — Local graph-native runtime"
	description="Entangle Local is the first complete Entangle product: a local graph-native runtime with host control plane, per-node runners, NIP-59 transport, git-backed artifact handoff, Studio + CLI, and a verified smoke."
>
	<main>
		<section class="pb-16 pt-12 text-white md:pb-24 md:pt-16">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
				<div>
					<div class="flex items-center gap-2">
						<StatusPill status="released" label="Available now · L1" />
					</div>
					<h1 class="mt-5 text-balance text-5xl font-[880] leading-[0.98] md:text-7xl">Entangle Local</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl md:leading-9">
						A local operator runtime for building, running, inspecting, and governing graph-native AI organizations on your own machine — with the same control-plane boundary the future Cloud and Enterprise products will inherit.
					</p>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a href="/docs/getting-started/" class="button-primary">
							<BookOpen size={18} stroke-width={2.4} />
							Get started
							<ArrowRight size={16} stroke-width={2.4} />
						</a>
						<a href="https://github.com/entangle-run/entangle" class="button-secondary" rel="noreferrer">
							<GitBranch size={18} stroke-width={2.4} />
							Repository
						</a>
					</div>
				</div>
				<div class="panel p-5">
					<div class="grid gap-3 sm:grid-cols-2">
						{services.map((s) => (
							<div class="rounded-[6px] border border-white/10 bg-white/[0.05] p-4">
								<p class="font-mono text-[11px] font-black uppercase tracking-[0.14em] text-teal-200">{s.label}</p>
								<p class="mt-1.5 text-sm leading-6 text-slate-300">{s.value}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section-pad bg-white">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-700">In the box</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Twelve concrete capabilities, in one local profile.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-600">
						L1 is the first final product line. It is not a slide deck and not a managed-platform claim. Every capability here is wired through the actual host, runner, and shared client packages, with tests and a verifiable local smoke.
					</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{l1Capabilities.map(({ Icon, label, body }) => (
						<article class="paper-panel p-6">
							<Icon size={22} stroke-width={2.2} class="text-teal-700" />
							<h3 class="mt-5 text-lg font-[820] leading-tight text-slate-950">{label}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#f7f9fc]">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.95fr_1.05fr]">
				<div>
					<p class="eyebrow text-teal-700">Run it</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Three commands to a verified local profile.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-600">
						The repo ships preflight checks for Node, pnpm, Docker, Compose, and the Compose configuration itself, plus an active and a disposable smoke that exercise host, runner, relay, Gitea, and a real artifact roundtrip.
					</p>
					<div class="mt-7 grid gap-3 text-sm font-bold text-slate-700">
						<div class="flex items-start gap-3"><Route size={18} class="mt-0.5 shrink-0 text-teal-700" stroke-width={2.3} />Studio at <code class="font-mono text-slate-900">localhost:3000</code></div>
						<div class="flex items-start gap-3"><Route size={18} class="mt-0.5 shrink-0 text-teal-700" stroke-width={2.3} />Host API at <code class="font-mono text-slate-900">localhost:7071</code></div>
						<div class="flex items-start gap-3"><Route size={18} class="mt-0.5 shrink-0 text-teal-700" stroke-width={2.3} />Gitea at <code class="font-mono text-slate-900">localhost:3001</code></div>
						<div class="flex items-start gap-3"><Route size={18} class="mt-0.5 shrink-0 text-teal-700" stroke-width={2.3} />Nostr relay at <code class="font-mono text-slate-900">ws://localhost:7777</code></div>
					</div>
				</div>
				<div class="grid gap-4">
					<CommandBlock
						caption="install + preflight"
						commands={[
							'git clone https://github.com/entangle-run/entangle.git',
							'cd entangle && pnpm install',
							'pnpm verify',
							'pnpm ops:check-local:strict',
						]}
					/>
					<CommandBlock
						caption="local profile"
						commands={[
							'docker compose -f deploy/local/compose/docker-compose.local.yml \\',
							'  --profile runner-build build runner-image',
							'docker compose -f deploy/local/compose/docker-compose.local.yml \\',
							'  up --build studio host strfry gitea',
						]}
					/>
					<CommandBlock
						caption="smoke (disposable)"
						commands={[
							'pnpm ops:smoke-local:disposable:runtime',
						]}
					/>
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide">
				<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
					<div>
						<p class="eyebrow text-teal-200">Release train</p>
						<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">L1 today, finished Local at L4.</h2>
					</div>
					<p class="text-lg leading-8 text-slate-300">
						Local is built in public, in stages. Each release adds utility without pretending the product is already a managed production platform. R1 is retained only as the historical name of the L1 release ledger.
					</p>
				</div>
				<div class="mt-12 grid gap-4">
					{releaseTrain.map((r) => (
						<article class="grid gap-5 rounded-[8px] border border-white/10 bg-white/[0.05] p-5 sm:grid-cols-[120px_1fr_auto] sm:items-center">
							<div class="font-mono text-sm font-black text-teal-200">{r.tag}</div>
							<div>
								<h3 class="text-xl font-[820] leading-tight text-white">{r.name}</h3>
								<p class="mt-2 text-sm leading-6 text-slate-300">{r.body}</p>
							</div>
							<div class="sm:justify-self-end">
								<StatusPill status={r.status} />
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-pad bg-[#eef6f4]">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.95fr_1.05fr]">
				<div>
					<p class="eyebrow text-teal-800">Boundary</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] text-slate-950 md:text-5xl">Local is a complete product, not a production SaaS claim.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-700">
						The L-train is allowed to be excellent inside its boundary. It deliberately does not claim multi-tenancy, production identity, or compliance — those are explicit Cloud and Enterprise scope.
					</p>
					<div class="mt-7 flex flex-wrap gap-3">
						<a href="/cloud/" class="button-dark">Cloud preview</a>
						<a href="/enterprise/" class="button-dark">Enterprise scope</a>
					</div>
				</div>
				<div class="paper-panel p-6">
					<p class="text-sm font-black uppercase tracking-[0.14em] text-slate-500">Not in Local</p>
					<ul class="mt-4 grid gap-3">
						{notIncluded.map((item) => (
							<li class="flex items-start gap-3 text-sm leading-6 text-slate-700">
								<span class="mt-2 size-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
								<span>{item}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<section class="section-pad bg-slate-950 text-white">
			<div class="container-wide grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
				<div>
					<p class="eyebrow text-teal-200">Architecture preview</p>
					<h2 class="mt-3 text-balance text-3xl font-[850] leading-[1.06] md:text-5xl">The same boundary travels with the product.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-300">
						Local uses the local Docker runtime backend. Cloud will introduce a production sandbox + scheduler. Enterprise packages the same control-plane facade for customer-operated infrastructure. The graph model does not change.
					</p>
					<a href="/architecture/" class="mt-7 inline-flex items-center gap-2 text-sm font-black text-teal-200 no-underline hover:text-white">Read the architecture <ArrowRight size={16} stroke-width={2.4} /></a>
				</div>
				<div class="panel p-4">
					<EntangleGraph />
				</div>
			</div>
		</section>

		<CtaStrip
			heading="Run a graph-native runtime locally tonight."
			body="Three commands and a Docker daemon. Inspect every node, edge, session, approval, turn, and artifact through Studio and the CLI."
		/>
	</main>
</SiteLayout>
